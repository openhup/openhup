# OpenHup environment.
#
#   cp openhup.env.example openhup.env && chmod 600 openhup.env
#
# This file holds secrets. It is gitignored. Everything that is *not* a secret belongs in
# config/config.yaml instead, so that file stays readable, diffable, and safe to paste into an issue.
#
# Naming: OPENHUP__SECTION__KEY maps onto config.yaml's structure, so
# OPENHUP__SECURITY__BIND_HOST overrides security.bind_host.

# ---------------------------------------------------------------- database
POSTGRES_USER=openhup
POSTGRES_DB=openhup
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
OPENHUP__DATABASE__URL=postgresql+asyncpg://openhup:CHANGE_ME_openssl_rand_base64_32@postgres:5432/openhup

# ---------------------------------------------------------------- bus
OPENHUP__BUS__URL=redis://redis:6379/0

# ---------------------------------------------------------------- session signing
# Generate with: openssl rand -base64 48
# Leave unset and OpenHup generates one into /var/lib/openhup/secret_key on first run.
# OPENHUP__SECURITY__SECRET_KEY=

# ---------------------------------------------------------------- camera credentials
# Referenced by name from config/cameras.yaml (`password_env: KITCHEN_CAM_PASSWORD`), never inline,
# so that file stays safe to commit and to share when asking for help.
KITCHEN_CAM_PASSWORD=
LIVING_CAM_PASSWORD=

# ---------------------------------------------------------------- LLM
# The AI layer is core (ADR-008): there is no "no LLM" mode. `openhup setup` asks for a
# provider - local Ollama by default, or a trusted cloud provider behind the egress gate below.
OPENHUP__LLM__PROVIDER=ollama
OPENHUP__LLM__BASE_URL=http://ollama:11434
OPENHUP__LLM__MODEL=qwen2.5:7b-instruct
# Optional vision model for scene descriptions. Costs a lot of RAM; the system works without it.
# OPENHUP__LLM__VISION_MODEL=qwen2.5vl:7b

# Remote provider. Both of these must be set deliberately - OpenHup refuses to start with a remote
# provider unless ALLOW_REMOTE_LLM is true, and it logs every outbound call with its byte count at
# /api/v1/system/llm-usage. Read docs/SECURITY_PRIVACY.md first.
# OPENHUP__LLM__PROVIDER=anthropic
# OPENHUP__LLM__API_KEY=
# OPENHUP__LLM__ALLOW_REMOTE_LLM=true
# text_only | redacted_image | full
# OPENHUP__LLM__REDACTION_PROFILE=text_only

# ---------------------------------------------------------------- voice
# Voice is browser-native by default: the PWA uses the browser's Web Speech API for both
# recognition and synthesis, and nothing is uploaded to OpenHup at all. The wake word is matched in
# the client before anything is processed. See docs/VOICE.md.
#
# Optional cloud STT/TTS. Both must be set deliberately: OpenHup refuses to start with a remote
# voice provider unless ALLOW_REMOTE_VOICE is true, and logs every outbound call with its byte
# count at /api/v1/system/llm-usage.
# OPENHUP__VOICE__STT_PROVIDER=openai
# OPENHUP__VOICE__TTS_PROVIDER=openai
# OPENHUP__VOICE__API_KEY=
# OPENHUP__VOICE__ALLOW_REMOTE_VOICE=true
# Point openai_compatible at a local gateway (whisper.cpp / Piper) with treat_as_local:
# OPENHUP__VOICE__STT_PROVIDER=openai_compatible
# OPENHUP__VOICE__TTS_PROVIDER=openai_compatible
# OPENHUP__VOICE__BASE_URL=http://whisper:8080/v1
# OPENHUP__VOICE__TREAT_AS_LOCAL=true

# ---------------------------------------------------------------- identity
# Consent-gated "who is in the room" (ADR-016). On by default, and the consent flow is the gate:
# the camera computes a face embedding only to ask whether it may remember the person, nothing is
# stored until they answer "yes", and a "no" writes a date marker, never a face. Identity is
# presence, never attribution. Set OPENHUP__IDENTITY__ENABLED=false to remove it entirely.
# OPENHUP__IDENTITY__ENABLED=true
# A face must score this well against an enrolled member to be named. Keep it strict: a wrong
# name is the worst thing the assistant can say.
# OPENHUP__IDENTITY__MATCH_THRESHOLD=0.55

# ---------------------------------------------------------------- vision service
# Bearer token the vision service uses to pull its detector plan. Generate with:
#   openssl rand -hex 32
OPENHUP_VISION_TOKEN=CHANGE_ME_openssl_rand_hex_32
OPENHUP__SECURITY__SERVICE_TOKENS__VISION=CHANGE_ME_openssl_rand_hex_32

# Threads per ONNX Runtime session. Keep it low: this box does other things too.
ORT_THREADS=2
# Render group id for the OpenVINO profile. Find yours with:
#   stat -c '%g' /dev/dri/renderD128
RENDER_GID=109

# ---------------------------------------------------------------- notifications
# Self-hosted ntfy is the recommended default: no account, works on iOS and Android, carries images.
NTFY_TOPIC=openhup-CHANGE_ME_something_unguessable
# NTFY_TOKEN=
# DISCORD_WEBHOOK_URL=
# MATRIX_ACCESS_TOKEN=

# ---------------------------------------------------------------- exposure
# 0.0.0.0 inside the container is fine: compose publishes it on 127.0.0.1 only. Do not publish this
# port to a LAN or the internet without a reverse proxy and authentication in front.
OPENHUP__SECURITY__BIND_HOST=0.0.0.0
OPENHUP__SECURITY__BIND_PORT=8080
OPENHUP__SECURITY__TRUST_PROXY_HEADERS=true

# For remote access, prefer Tailscale or WireGuard over exposing anything publicly. If you do expose
# it, set your hostname here and use the `proxy` profile so Caddy gets a certificate.
# OPENHUP_DOMAIN=openhup.example.org

# ---------------------------------------------------------------- personality
# The voice is set by `openhup setup` (pick one of the five, or gamble and let it draw one).
# A gambled voice is drawn at first launch and never announced - you discover it by living
# with it (ADR-014).
OPENHUP__PERSONALITY__DEFAULT_PERSONALITY=kind_coach
# 1..5. Nobody in the household can be raised above this.
OPENHUP__PERSONALITY__HUMOR_CEILING=3
# Required before any personality reaches intensity 4+.
OPENHUP__PERSONALITY__ROAST_CONSENT=false
# OPENHUP__PERSONALITY__GAMBLE=true
# OPENHUP__PERSONALITY__GAMBLE_POOL=[friendly, shy, sassy, sarcastic, angry]

TZ=UTC
